# StoreMate Environment Variables

# Supabase (Optional for local demo mode, required for cloud production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sarvam AI (Optional - client has full intelligent fallback + rule parser)
SARVAM_API_KEY=your-sarvam-api-key

# LLM API (OpenAI / Anthropic / Gemini - optional, app includes built-in semantic parser fallback)
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=gemini

# Firebase Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-fcm-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
